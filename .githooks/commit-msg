# Commit checks, installed with `make install-hooks`: subject format, license headers on new files, gofmt, build
# and lint. Set SKIP_COMMIT_HOOKS=1 to bypass in an emergency; CI runs the same checks.

set -euo pipefail

if [[ -n "${SKIP_COMMIT_HOOKS:-}" ]]; then
    exit 0
fi

commit_message_file=$1
subject=$(head -n 1 "$commit_message_file" | tr -d '\r')
repo_root=$(git rev-parse --show-toplevel)

if ! git rev-parse --quiet --verify MERGE_HEAD >/dev/null 2>&1 \
    && [[ "$subject" != "fixup! "* ]] \
    && [[ "$subject" != "squash! "* ]]; then
    python3 "$repo_root/.github/scripts/validate_commits.py" "$subject"
fi

missing_license=()
while IFS= read -r -d '' file; do
    if [[ -f "$file" ]] && ! head -n 3 -- "$file" | grep -q 'Copyright (c) [0-9]\{4\}, WSO2 LLC. (http://www.wso2.com).'; then
        missing_license+=("$file")
    fi
done < <(git diff --cached --name-only --diff-filter=A -z -- '*.go' '*.bal' '*.py' '*.sh')

if (( ${#missing_license[@]} > 0 )); then
    printf 'The following new files are missing the WSO2 license header:\n' >&2
    printf '  %s\n' "${missing_license[@]}" >&2
    exit 1
fi

unformatted=$(gofmt -l -s engine)
if [[ -n "$unformatted" ]]; then
    printf 'Go formatting check failed:\n%s\n' "$unformatted" >&2
    exit 1
fi

if ! command -v golangci-lint >/dev/null 2>&1; then
    cat >&2 <<'MSG'
golangci-lint is required to run commit checks.
Install the version used by CI with:
  go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.13.2
MSG
    exit 1
fi

make -j4 build lint
